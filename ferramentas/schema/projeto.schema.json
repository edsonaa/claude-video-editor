{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeiteZ/fluxo-de-edicao/ferramentas/schema/projeto.schema.json",
  "title": "Estado de um vídeo (_CLAUDE/projeto.json)",
  "description": "A memória do fluxo de edição. Os blocos são gravados pelos scripts de cada etapa; itens aceitam campos extras para cada fluxo se adaptar, mas os campos listados aqui têm sempre este formato. Tempos de corte, marcadores e notas ficam no tempo do arquivo de origem, em segundos.",
  "type": "object",
  "required": ["schema", "revisao", "projeto", "fluxo", "etapas"],
  "properties": {
    "schema": { "const": 1, "description": "Versão deste schema." },
    "revisao": { "type": "integer", "minimum": 0, "description": "Sobe a cada gravação. Quem grava confere que ninguém gravou no meio (o painel e o Claude podem gravar no mesmo arquivo)." },
    "projeto": { "type": "string", "minLength": 1 },
    "perfil": { "type": ["string", "null"] },
    "criado_em": { "$ref": "#/$defs/data" },
    "atualizado_em": { "$ref": "#/$defs/data" },
    "fluxo": {
      "type": "array",
      "description": "As etapas deste fluxo, na ordem.",
      "items": { "$ref": "#/$defs/nome_etapa" },
      "uniqueItems": true,
      "minItems": 1
    },
    "etapas": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nome_etapa" },
      "additionalProperties": { "$ref": "#/$defs/status_etapa" }
    },
    "ferramentas": {
      "type": "object",
      "description": "Versões fixas deste vídeo (ex.: hyperframes).",
      "additionalProperties": { "type": "string" }
    },
    "midia": {
      "type": "object",
      "properties": {
        "fps": { "$ref": "#/$defs/fps" },
        "resolucao": { "$ref": "#/$defs/resolucao" },
        "principal": { "$ref": "#/$defs/id_midia", "description": "Câmera de referência: todos os tempos do projeto são no tempo dela." },
        "audio_principal": { "$ref": "#/$defs/id_midia" },
        "arquivos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "caminho", "tipo"],
            "properties": {
              "id": { "$ref": "#/$defs/id_midia" },
              "caminho": { "type": "string", "description": "Caminho absoluto do original." },
              "proxy": { "type": ["string", "null"] },
              "tipo": { "enum": ["camera", "tela", "audio", "outro"] },
              "duracao": { "type": "number", "minimum": 0 },
              "fps": { "$ref": "#/$defs/fps" },
              "vfr": { "type": "boolean" },
              "resolucao": { "$ref": "#/$defs/resolucao" },
              "canais_audio": { "type": "integer", "minimum": 0 },
              "gravado_em": { "type": ["string", "null"] }
            }
          }
        },
        "sync": {
          "type": "array",
          "description": "tempo_na_referencia = tempo_no_arquivo + offset",
          "items": {
            "type": "object",
            "required": ["id", "referencia", "offset"],
            "properties": {
              "id": { "$ref": "#/$defs/id_midia" },
              "referencia": { "$ref": "#/$defs/id_midia" },
              "offset": { "type": "number" },
              "confianca": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "transcricao": {
      "type": "object",
      "properties": {
        "motor": { "type": "string" },
        "palavras": { "type": "object", "description": "id da mídia → caminho do JSON normalizado.", "additionalProperties": { "type": "string" } },
        "frases": { "type": "object", "additionalProperties": { "type": "string" } },
        "silencios": { "type": "object", "additionalProperties": { "type": "string" } },
        "lacunas": {
          "type": "array",
          "description": "Trechos com som e sem palavra (podem ser takes engolidos).",
          "items": { "$ref": "#/$defs/trecho_origem" }
        }
      }
    },
    "notas_edicao": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "video", "inicio", "fim", "texto"],
        "properties": {
          "id": { "type": "string", "pattern": "^n\\d+$" },
          "video": { "$ref": "#/$defs/id_midia" },
          "inicio": { "$ref": "#/$defs/segundos" },
          "fim": { "$ref": "#/$defs/segundos" },
          "texto": { "type": "string" },
          "interpretacao": { "type": "string" },
          "etapa": { "$ref": "#/$defs/nome_etapa" },
          "confianca": { "enum": ["alta", "media", "baixa"] }
        }
      }
    },
    "cortes": {
      "type": "object",
      "required": ["versao", "segmentos"],
      "properties": {
        "versao": { "type": "integer", "minimum": 1, "description": "Sobe sozinha quando os segmentos mudam." },
        "segmentos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "video", "inicio", "fim"],
            "properties": {
              "id": { "type": "string", "pattern": "^s\\d+$" },
              "video": { "$ref": "#/$defs/id_midia" },
              "inicio": { "$ref": "#/$defs/segundos" },
              "fim": { "$ref": "#/$defs/segundos" },
              "texto": { "type": "string" }
            }
          }
        }
      }
    },
    "marcadores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "video", "tempo", "tipo", "texto"],
        "properties": {
          "id": { "type": "string", "pattern": "^m\\d+$" },
          "video": { "$ref": "#/$defs/id_midia" },
          "tempo": { "$ref": "#/$defs/segundos" },
          "duracao": { "type": "number", "minimum": 0 },
          "tipo": { "enum": ["duvida_take", "hesitacao", "nota", "sugestao", "alerta", "asset_faltando", "pos", "pessoa"] },
          "texto": { "type": "string" },
          "etapa": { "$ref": "#/$defs/nome_etapa" }
        }
      }
    },
    "motions": {
      "type": "object",
      "properties": {
        "versao": { "type": "integer", "minimum": 1 },
        "base_cortes_versao": { "type": "integer", "description": "Versão do corte sobre a qual o plano foi feito." },
        "trechos": { "type": "object" },
        "itens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^mo\\d+$" },
              "status": { "enum": ["proposto", "aprovado", "ajustar", "riscado", "construido", "renderizado", "entregue"] },
              "inicio_seq": { "$ref": "#/$defs/segundos" },
              "fim_seq": { "$ref": "#/$defs/segundos" },
              "formato": { "enum": ["tela_cheia", "sobreposicao", "sobreposicao_lateral", "enfase"] },
              "ideia": { "type": "string" },
              "render": {
                "type": "object",
                "properties": {
                  "arquivo": { "type": "string" },
                  "versao": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "properties": {
        "base_cortes_versao": { "type": "integer" },
        "base_motions_versao": { "type": "integer" },
        "movimentos": {
          "type": "array",
          "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^cam\\d+$" } } }
        },
        "recortes": { "type": "array" }
      }
    },
    "sfx": {
      "type": "object",
      "properties": {
        "base_cortes_versao": { "type": "integer" },
        "base_motions_versao": { "type": "integer" },
        "itens": {
          "type": "array",
          "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^sfx\\d+$" } } }
        },
        "recortes": { "type": "array" }
      }
    },
    "pendencias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "etapa", "texto"],
        "properties": {
          "id": { "type": "string", "pattern": "^p\\d+$" },
          "etapa": { "$ref": "#/$defs/nome_etapa" },
          "texto": { "type": "string", "minLength": 1 },
          "item": { "type": "string" },
          "criada_em": { "$ref": "#/$defs/data" },
          "resolvida_em": { "$ref": "#/$defs/data" }
        }
      }
    },
    "entregas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["etapa", "arquivo"],
        "properties": {
          "etapa": { "$ref": "#/$defs/nome_etapa" },
          "arquivo": { "type": "string" },
          "versao": { "type": "integer", "minimum": 1 },
          "data": { "$ref": "#/$defs/data" }
        }
      }
    }
  },
  "$defs": {
    "nome_etapa": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "status_etapa": {
      "anyOf": [
        { "enum": ["pendente", "em_andamento", "aguardando_aprovacao", "concluido", "nao_precisa"] },
        { "type": "string", "pattern": "^aguardando_[a-z0-9_]+$" }
      ]
    },
    "id_midia": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "fps": { "type": "string", "pattern": "^\\d+(/\\d+)?$", "description": "Fração exata, ex.: 30000/1001." },
    "resolucao": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
    "segundos": { "type": "number", "minimum": 0 },
    "data": { "type": "string" },
    "trecho_origem": {
      "type": "object",
      "required": ["video", "inicio", "fim"],
      "properties": {
        "video": { "$ref": "#/$defs/id_midia" },
        "inicio": { "$ref": "#/$defs/segundos" },
        "fim": { "$ref": "#/$defs/segundos" }
      }
    }
  }
}
