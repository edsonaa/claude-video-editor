  "zoom": {
    "titulo": "Zoom",
    "descricao": "A imagem avança para dentro e a próxima surge no lugar. Puxa o olho para o que vem.",
    "bom_para": "entrar num detalhe, ir da fala para a tela, ritmo de vídeo curto",
    "evitar": "vídeo longo e calmo; seguido de outro zoom",
    "xfade": "zoomin",
    "duracao": {
      "padrao": 0.45,
      "min": 0.25,
      "max": 1.0
    },
    "xml": {
      "nome": "Cross Dissolve",
      "effectid": "Cross Dissolve",
      "categoria": "Dissolve",
      "aproximada": true
    },
    "previa": {
      "a": [
        {
          "transform": "scale(1)",
          "opacity": 1
        },
        {
          "transform": "scale(2.2)",
          "opacity": 0
        }
      ],
      "b": [
        {
          "transform": "scale(1.04)",
          "opacity": 1
        },
        {
          "transform": "scale(1)",
          "opacity": 1
        }
      ],
      "a_cima": true
    }
  },
  "empurrar": {
    "titulo": "Empurrar",
    "descricao": "A próxima imagem entra de lado e empurra a anterior para fora. Sensação de próximo item.",
    "bom_para": "lista de passos, comparar um e outro, sequência de exemplos",
    "evitar": "entre takes da mesma fala",
    "xfade": "slideleft",
    "duracao": {
      "padrao": 0.4,
      "min": 0.25,
      "max": 1.0
    },
    "xml": {
      "nome": "Cross Dissolve",
      "effectid": "Cross Dissolve",
      "categoria": "Dissolve",
      "aproximada": true
    },
    "previa": {
      "a": [
        {
          "transform": "translateX(0)"
        },
        {
          "transform": "translateX(-100%)"
        }
      ],
      "b": [
        {
          "transform": "translateX(100%)"
        },
        {
          "transform": "translateX(0)"
        }
      ]
    }
  },
  "chicote": {
    "titulo": "Chicote",
    "descricao": "Um giro rápido de câmera borrado, de uma imagem para a outra. Energia de vídeo curto.",
    "bom_para": "reels, ganchos, trocar de lugar ou de assunto com pressa",
    "evitar": "aula e tutorial longo; mais de duas seguidas",
    "xfade": "hblur",
    "duracao": {
      "padrao": 0.3,
      "min": 0.15,
      "max": 0.7
    },
    "xml": {
      "nome": "Cross Dissolve",
      "effectid": "Cross Dissolve",
      "categoria": "Dissolve",
      "aproximada": true
    },
    "previa": {
      "a": [
        {
          "transform": "translateX(0)",
          "filter": "blur(0)",
          "opacity": 1
        },
        {
          "transform": "translateX(-55%)",
          "filter": "blur(14px)",
          "opacity": 0
        }
      ],
      "b": [
        {
          "transform": "translateX(55%)",
          "filter": "blur(14px)",
          "opacity": 0
        },
        {
          "transform": "translateX(0)",
          "filter": "blur(0)",
          "opacity": 1
        }
      ]
    }
  }
