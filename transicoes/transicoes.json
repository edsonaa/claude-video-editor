{
  "dissolver": {
    "titulo": "Dissolver",
    "descricao": "Uma imagem some enquanto a outra aparece. A passagem de tempo ou de assunto mais discreta que existe.",
    "bom_para": "mudança de assunto, passagem de tempo, juntar dois takes parecidos sem pulo",
    "evitar": "em todo corte (vira vício); no meio de uma frase",
    "xfade": "fade",
    "duracao": {
      "padrao": 0.5,
      "min": 0.2,
      "max": 2.0
    },
    "xml": {
      "nome": "Cross Dissolve",
      "effectid": "Cross Dissolve",
      "categoria": "Dissolve"
    },
    "previa": {
      "b": [
        {
          "opacity": 0
        },
        {
          "opacity": 1
        }
      ]
    }
  },
  "fade_preto": {
    "titulo": "Passar pelo preto",
    "descricao": "A imagem escurece até o preto e a próxima nasce dele. Fecha um bloco e abre outro.",
